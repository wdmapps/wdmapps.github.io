// Copie este bloco para Firestore Database > Regras no Firebase Console.
// Se já existem outras regras no seu projeto, INSIRA apenas o bloco match abaixo
// dentro do seu match /databases/{database}/documents existente, sem apagar outras coleções.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /entregador_maluco_ranking/{playerId} {
      allow read: if true;
      function valid() {
        return request.auth != null
          && request.auth.uid == playerId
          && request.resource.data.keys().hasOnly(['name','points','stage','deliveries','distance','updatedAt'])
          && request.resource.data.keys().hasAll(['name','points','stage','deliveries','distance','updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 18
          && request.resource.data.stage is int && request.resource.data.stage >= 1 && request.resource.data.stage <= 40
          && request.resource.data.deliveries is int && request.resource.data.deliveries >= 0 && request.resource.data.deliveries <= 9999
          && request.resource.data.distance is int && request.resource.data.distance >= 0 && request.resource.data.distance <= 999999
          && request.resource.data.points is int
          && request.resource.data.points == request.resource.data.stage * 100000 + request.resource.data.deliveries * 100 + (request.resource.data.distance / 50)
          && request.resource.data.updatedAt is int;
      }
      allow create: if valid();
      allow update: if valid() && request.resource.data.points >= resource.data.points;
      allow delete: if false;
    }
  }
}
// OBS: Este ranking é recreativo. Dados enviados pelo navegador podem ser manipulados.
// Para competição com prêmios, valide pontuação e entregas em um servidor confiável.
