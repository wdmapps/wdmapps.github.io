rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isWdmOwner() {
      return request.auth != null
        && request.auth.uid == 'cNUIxdJzXIaut7VnoGBx9EAzgRM2';
    }

    function hasActiveSubscription(storeId) {
      return request.auth != null
        && request.auth.uid == storeId
        && (isWdmOwner()
          || (firestore.exists(/databases/(default)/documents/subscriptions/$(storeId))
            && subscriptionAllowsAccess(storeId)));
    }

    function subscriptionAllowsAccess(storeId) {
      let subscription = firestore.get(/databases/(default)/documents/subscriptions/$(storeId)).data;
      return subscription.entitled == true
        && (!('provider' in subscription)
          || subscription.provider != 'manual'
          || (subscription.currentPeriodEnd is timestamp
            && subscription.currentPeriodEnd > request.time));
    }

    match /stores/{storeId}/products/{productId}/{fileName} {
      allow read: if true;

      allow create, update: if hasActiveSubscription(storeId)
                            && request.resource.size < 2 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      allow delete: if hasActiveSubscription(storeId);
    }
  }
}
