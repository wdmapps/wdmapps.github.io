rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasActiveSubscription(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/subscriptions/$(uid))
        && get(/databases/$(database)/documents/subscriptions/$(uid)).data.entitled == true;
    }

    match /users/{uid} {
      allow create, read, update, delete: if isOwner(uid);
    }

    // O navegador pode apenas consultar a própria assinatura.
    // A criação/alteração deste documento será feita pelo backend após validar o Google Play.
    match /subscriptions/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    match /slugs/{slugId} {
      allow read: if true;

      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.storeId == request.auth.uid
                    && hasActiveSubscription(request.auth.uid);

      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.storeId == resource.data.storeId
                    && hasActiveSubscription(request.auth.uid);

      allow delete: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && hasActiveSubscription(request.auth.uid);
    }

    match /stores/{storeId} {
      // O dono pode consultar os próprios dados mesmo com a assinatura vencida.
      // A vitrine pública continua dependendo do campo published; quando a assinatura
      // vencer, o backend do Google Play colocará published=false.
      allow read: if isOwner(storeId)
                  || resource.data.published == true;

      allow create: if isOwner(storeId)
                    && hasActiveSubscription(storeId)
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if isOwner(storeId)
                    && hasActiveSubscription(storeId)
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isOwner(storeId)
                    && hasActiveSubscription(storeId)
                    && resource.data.ownerId == request.auth.uid;

      match /products/{productId} {
        function parentStore() {
          return get(/databases/$(database)/documents/stores/$(storeId));
        }

        allow read: if isOwner(storeId)
                    || (parentStore().data.published == true
                        && resource.data.active == true);

        allow create, update, delete: if isOwner(storeId)
                                      && hasActiveSubscription(storeId);
      }
    }
  }
}
