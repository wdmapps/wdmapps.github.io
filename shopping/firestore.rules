rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isWdmOwner() {
      return signedIn()
        && request.auth.uid == 'cNUIxdJzXIaut7VnoGBx9EAzgRM2';
    }

    function hasActiveSubscription(uid) {
      return isWdmOwner()
        || (signedIn()
          && exists(/databases/$(database)/documents/subscriptions/$(uid))
          && subscriptionAllowsAccess(uid));
    }

    function subscriptionAllowsAccess(uid) {
      let subscription = get(/databases/$(database)/documents/subscriptions/$(uid)).data;
      return subscription.entitled == true
        && (!('provider' in subscription)
          || subscription.provider != 'manual'
          || (subscription.currentPeriodEnd is timestamp
            && subscription.currentPeriodEnd > request.time));
    }

    match /users/{uid} {
      allow create, read, update, delete: if isOwner(uid);
    }

    // O navegador pode apenas consultar a própria assinatura.
    // A criação/alteração deste documento é feita pelo backend Stripe via Admin SDK.
    match /subscriptions/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    match /slugs/{slugId} {
      allow read: if true;

      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.storeId == request.auth.uid
                    && hasActiveSubscription(request.auth.uid);

      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.storeId == resource.data.storeId
                    && hasActiveSubscription(request.auth.uid);

      allow delete: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && hasActiveSubscription(request.auth.uid);
    }

    match /stores/{storeId} {
      // O dono pode consultar os próprios dados mesmo com a assinatura vencida.
      // Quando a Stripe suspender/encerrar o direito de acesso, o backend coloca
      // published=false; se o pagamento voltar e a suspensão foi por cobrança,
      // o backend restaura a publicação.
      allow read: if isOwner(storeId)
                  || isWdmOwner()
                  || resource.data.published == true;

      allow create: if isOwner(storeId)
                    && hasActiveSubscription(storeId)
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if isOwner(storeId)
                    && hasActiveSubscription(storeId)
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isOwner(storeId)
                    && hasActiveSubscription(storeId)
                    && resource.data.ownerId == request.auth.uid;

      match /products/{productId} {
        function parentStore() {
          return get(/databases/$(database)/documents/stores/$(storeId));
        }

        function isAdultStore() {
          let store = parentStore().data;
          return store.category == 'Sex Shop (18+)'
            || (store.accountType == 'both'
              && ('storeProfile' in store)
              && store.storeProfile.category == 'Sex Shop (18+)');
        }

        allow read: if isOwner(storeId)
                    || isWdmOwner()
                    || (parentStore().data.published == true
                        && (!('adminSuspended' in parentStore().data)
                          || parentStore().data.adminSuspended != true)
                        && resource.data.active == true
                        && (!isAdultStore()
                          || (('listingType' in resource.data)
                            && resource.data.listingType == 'service')
                          || resource.data.adultApprovalStatus == 'approved'));

        // O lojista adulto sempre envia o anúncio como pendente. Somente o
        // backend administrativo pode gravar o estado "approved".
        allow create, update: if isOwner(storeId)
                              && hasActiveSubscription(storeId)
                              && (!('adultApprovalStatus' in request.resource.data)
                                || request.resource.data.adultApprovalStatus != 'approved');

        allow delete: if isOwner(storeId)
                      && hasActiveSubscription(storeId);
      }
    }
  }
}
